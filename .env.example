# Google Analytics 4 Measurement ID
# Get this from: https://analytics.google.com/ -> Admin -> Data Streams -> Your Stream -> Measurement ID
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google AdSense Publisher ID (optional)
# Get this from: https://www.google.com/adsense/ -> Account -> Account Information
NEXT_PUBLIC_ADSENSE_ID=ca-pub-XXXXXXXXXX

# Admin Panel Secret Password
# Choose a strong password for accessing /admin
ADMIN_SECRET=your-super-secret-password-here
